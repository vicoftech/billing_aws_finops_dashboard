        "type": "table",
        "targets": [
          {
            "rawSql": "SELECT line_item_resource_id, line_item_product_code, line_item_usage_type, SUM(line_item_blended_cost) as total_cost, SUM(line_item_usage_amount) as usage_amount FROM cur_report_sample WHERE billing_period = (SELECT MAX(billing_period) FROM cur_report_sample) AND line_item_usage_amount < 1 AND line_item_resource_id IS NOT NULL GROUP BY line_item_resource_id, line_item_product_code, line_item_usage_type ORDER BY total_cost DESC LIMIT 10",
