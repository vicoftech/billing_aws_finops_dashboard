{
  "dashboard": {
    "id": null,
    "title": "AWS FinOps CUR Cost & Resource Analysis",
    "tags": ["finops", "aws", "cur", "cost-analysis", "athena"],
    "timezone": "UTC",
    "panels": [
      {
        "id": 1,
        "title": "Current Month Total Cost",
        "type": "stat",
        "targets": [
          {
            "rawSql": "SELECT SUM(line_item_blended_cost) as total_cost FROM cur_report_sample WHERE billing_period = (SELECT MAX(billing_period) FROM cur_report_sample)",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 1000
                },
                {
                  "color": "red",
                  "value": 5000
                }
              ]
            },
            "unit": "currencyUSD",
            "decimals": 2
          }
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "Active Resources Count",
        "type": "stat",
        "targets": [
          {
            "rawSql": "SELECT COUNT(DISTINCT line_item_resource_id) as active_resources FROM cur_report_sample WHERE billing_period = (SELECT MAX(billing_period) FROM cur_report_sample) AND line_item_resource_id IS NOT NULL",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            },
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 6,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "Top Cost Services",
        "type": "barchart",
        "targets": [
          {
            "rawSql": "SELECT line_item_product_code, SUM(line_item_blended_cost) as total_cost FROM cur_report_sample WHERE billing_period = (SELECT MAX(billing_period) FROM cur_report_sample) GROUP BY line_item_product_code ORDER BY total_cost DESC LIMIT 10",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            },
            "unit": "currencyUSD",
            "decimals": 2
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "line_item_product_code"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Service"
                }
              ]
            }
          ]
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 4
