            "rawSql": "SELECT line_item_usage_account_id, SUM(line_item_blended_cost) as total_cost FROM cur_report_sample WHERE billing_period = (SELECT MAX(billing_period) FROM cur_report_sample) GROUP BY line_item_usage_account_id ORDER BY total_cost DESC",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
